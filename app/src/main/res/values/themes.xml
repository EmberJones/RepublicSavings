<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RepublicSavingsApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Buttons -->
        <item name="colorPrimary">@color/green_5</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Background -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/green_5</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/green_5</item>

        <!-- Other accents -->
        <item name="colorSecondary">@color/green_4</item>
        <item name="colorOnSecondary">@color/white</item>

    </style>

    <!-- Bottom navigation bar -->
    <style name="Widget.RepublicSavingsApp.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="itemIconTint">@color/bottom_nav_icon_color</item>
        <item name="itemTextColor">@color/bottom_nav_label_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.RepublicSavingsApp.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.RepublicSavingsApp.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimary</item>
    </style>

    <style name="Theme.RepublicSavingsApp" parent="Base.Theme.RepublicSavingsApp" />
</resources>