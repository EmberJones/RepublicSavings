<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.categories.CategoriesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/categoriesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Categories"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/addCategoryButton" />

        <!-- Add button (top right) -->
        <ImageButton
            android:id="@+id/addCategoryButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_add"
            android:contentDescription="Add category"
            app:layout_constraintTop_toTopOf="@id/categoriesTitle"
            app:layout_constraintBottom_toBottomOf="@id/categoriesTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- YOUR CATEGORIES header -->
        <TextView
            android:id="@+id/yourCategoriesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="YOUR CATEGORIES"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/categoriesTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Existing category list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryListRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_category_row"
            tools:itemCount="4"
            app:layout_constraintTop_toBottomOf="@id/yourCategoriesHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CREATE NEW CATEGORY header -->
        <TextView
            android:id="@+id/createCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CREATE NEW CATEGORY"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/categoryListRecyclerView"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Category name label -->
        <TextView
            android:id="@+id/categoryNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Category name"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/createCategoryHeader"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Category name input -->
        <EditText
            android:id="@+id/categoryNameInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="e.g. Pet care"
            android:inputType="text"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/categoryNameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Choose an icon label -->
        <TextView
            android:id="@+id/chooseIconLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Choose an icon"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/categoryNameInput"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Icon picker row -->
        <LinearLayout
            android:id="@+id/iconPickerRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/chooseIconLabel"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/iconOption1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_option_selected"
                android:src="@drawable/ic_food"
                android:contentDescription="Food icon" />

            <ImageButton
                android:id="@+id/iconOption2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_option"
                android:src="@drawable/ic_heart"
                android:contentDescription="Heart icon" />

            <ImageButton
                android:id="@+id/iconOption3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_option"
                android:src="@drawable/ic_gift"
                android:contentDescription="Gift icon" />

            <ImageButton
                android:id="@+id/iconOption4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_option"
                android:src="@drawable/ic_paw"
                android:contentDescription="Pet icon" />

            <ImageButton
                android:id="@+id/moreIconsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_option"
                android:src="@drawable/ic_more_horiz"
                android:contentDescription="More icons" />

        </LinearLayout>

        <!-- Monthly maximum label -->
        <TextView
            android:id="@+id/monthlyMaxLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Monthly maximum"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/iconPickerRow"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Monthly maximum input -->
        <EditText
            android:id="@+id/monthlyMaxInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:hint="e.g. R1,500"
            android:inputType="numberDecimal"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/monthlyMaxLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>