<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ui.signup.SignUpStep2Fragment">

    <!-- Back arrow -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        app:tint="?attr/colorOnSurface"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Step progress bar -->
    <ProgressBar
        android:id="@+id/stepProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:max="3"
        android:progress="2"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Step label -->
    <TextView
        android:id="@+id/stepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Step 2 of 3"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/currencyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Set your currency"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/stepLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/currencySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="We'll use this for your budgets and reports"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/currencyTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Local currency label -->
    <TextView
        android:id="@+id/localCurrencyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Local currency"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/currencySubtitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Local currency dropdown -->
    <Spinner
        android:id="@+id/currencySpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/localCurrencyLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Or pick a common option" label -->
    <TextView
        android:id="@+id/commonOptionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Or pick a common option"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/currencySpinner"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Currency option list -->
    <RadioGroup
        android:id="@+id/currencyOptionGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/commonOptionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Option: South African rand -->
        <RadioButton
            android:id="@+id/optionZar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:checked="true"
            android:text="R   South African Rand"
            android:textSize="14sp"
            android:padding="14dp"
            android:buttonTint="?attr/colorOnSurface" />

        <!-- Option: US dollar -->
        <RadioButton
            android:id="@+id/optionUsd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="$   US dollar"
            android:textSize="14sp"
            android:padding="14dp"
            android:buttonTint="?attr/colorOnSurface" />

        <!-- Option: Euro -->
        <RadioButton
            android:id="@+id/optionEur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="€   Euro"
            android:textSize="14sp"
            android:padding="14dp"
            android:buttonTint="?attr/colorOnSurface" />

    </RadioGroup>

    <!-- Continue button -->
    <Button
        android:id="@+id/continueButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:text="Continue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>