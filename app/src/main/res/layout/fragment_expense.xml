<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".ui.expense.ExpenseFragment">

    <!-- Title -->
    <TextView
        android:id="@+id/transactionsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Transactions"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/periodFilter" />

    <!-- Period filter dropdown -->
    <TextView
        android:id="@+id/periodFilter"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Past month"
        android:textSize="18sp"
        android:drawableEnd="@drawable/ic_chevron_down"
        android:drawablePadding="4sp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/transactionsTitle"
        app:layout_constraintBottom_toBottomOf="@id/transactionsTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Total amount + category breakdown card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/totalsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transactionsTitle">

        <!-- Total spent -->
        <TextView
            android:id="@+id/totalAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="R12,800" />

        <!-- Category breakdown pie chart (populated in ExpenseFragment) -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/categoryPieChart"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/totalAmountText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Search -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Search expenses"
        android:inputType="text"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/totalsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Transaction list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_transaction"
        tools:itemCount="5"
        app:layout_constraintTop_toBottomOf="@id/searchInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>