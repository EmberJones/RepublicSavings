<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/rowCategoryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_category_placeholder"
            android:contentDescription="Category icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/rowCategoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Category Name"
            app:layout_constraintTop_toTopOf="@id/rowCategoryIcon"
            app:layout_constraintStart_toEndOf="@id/rowCategoryIcon"
            app:layout_constraintEnd_toStartOf="@id/rowChevron" />

        <TextView
            android:id="@+id/rowCategoryMax"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            tools:text="R1,500 monthly max"
            app:layout_constraintTop_toBottomOf="@id/rowCategoryName"
            app:layout_constraintStart_toStartOf="@id/rowCategoryName"
            app:layout_constraintEnd_toStartOf="@id/rowChevron" />

        <ImageView
            android:id="@+id/rowChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="View category"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
